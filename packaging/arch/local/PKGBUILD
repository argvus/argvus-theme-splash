# Maintainer: William C. Canin
pkgname=argvus-loading-theme
pkgver=0.1.0
pkgrel=1
pkgdesc="GTK4 Wayland layer-shell overlay for ARGVUS theme and session transitions"
arch=('x86_64')
url="https://github.com/argvus/argvus-loading-theme"
license=('GPL-3.0-only')
options=('!debug')
depends=(
  'argvus-i18n'
  'gtk4'
  'gtk4-layer-shell'
)
makedepends=(
  'cargo'
  'pkgconf'
)
replaces=('argvus-theme-splash')
conflicts=('argvus-theme-splash')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

_source_dir() {
  find "${srcdir}" -mindepth 1 -maxdepth 1 -type d -name "${pkgname}-*" -print -quit
}

_cargo_target_dir() {
  printf '%s' "${CARGO_TARGET_DIR:-$(_source_dir)/target}"
}

prepare() {
  cd "$(_source_dir)"
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "$(_source_dir)"
  cargo build --workspace --release --locked
}

check() {
  cd "$(_source_dir)"
  cargo test --workspace --release --locked
}

package() {
  cd "$(_source_dir)"
  install -Dm755 "$(_cargo_target_dir)/release/splash" "${pkgdir}/usr/lib/argvus/loading-theme/splash"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
